    "\n",
    "def my_reducer(left: list[str], right: list[str]) -> list[str]:\n",
    "    return left + right\n",
    "\n",
    "left = [\"start\",\"node_1 running done\"]\n",
    "right = [\"node_2 running done\"]\n",
    "\n",
    "merged = my_reducer(left, right)\n",
    "print(merged)\n"
   ]
